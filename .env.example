# ─── نمونهٔ متغیرهای محیطی «کارگردان» ─────────────────────────────────
# این فایل را به `.env.local` کپی کن و مقادیر واقعی را بگذار.
# روی Vercel به‌جای فایل، در Settings → Environment Variables وارد کن
# (برای هر سه محیط Production، Preview و Development).
#
# ⚠️ هرگز این فایل را با رمز واقعی کامیت نکن.

# رشتهٔ اتصال دیتابیس — هر کدام از این نام‌ها کار می‌کند (به همین ترتیب اولویت):
PRISMA_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"
# POSTGRES_URL=""
# DATABASE_URL=""
# POSTGRES_PRISMA_URL=""
# POSTGRES_URL_NON_POOLING=""

# اختیاری — به‌طور پیش‌فرض SSL برای سرویس‌های ابری روشن و برای localhost خاموش است.
# اگر خطای «گواهی SSL» گرفتی و مطمئنی میزبان درست است، این را 0 بگذار:
DB_SSL_STRICT=0

# ─── ایجنت همکار (اختیاری — معمولاً لازم نیست) ─────────────────────
# 🔑 کلید ایجنت همکار دیگر اینجا لازم نیست!
#    برنامه خودش کلید را می‌سازد و در دیتابیس ذخیره می‌کند.
#    کنترل روشن/خاموش و ساخت کلید جدید: برنامه → تب «🔌 ایجنت همکار»
#
# این متغیر فقط برای کاربردهای پیشرفته است: اگر مقدارش را بگذاری،
# بر کلید دیتابیس مقدم می‌شود و در رابط کاربری نمایش داده نمی‌شود.
# کلید توقف (دکمهٔ «قطع دسترسی») همیشه اعمال می‌شود، حتی با این متغیر.
# AGENT_API_KEY=""
